{
  "appId": "com.yavatmalhealthmarathon.coach",
  "appName": "YHM Coach",
  "webDir": "app-www",
  "android": {
    "backgroundColor": "#121512"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#121512",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_yhm",
      "iconColor": "#7DC243"
    },
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "ios": {
    "backgroundColor": "#121512"
  }
}
